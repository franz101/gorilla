#!/bin/sh
# GORILLAS.BAS — terminal edition (Node.js + P2P + ASCII pixels)
# curl https://franz101.github.io/gorilla/cli | sh
set -e
# Prefer Node.js (with P2P + pixel graphics), fallback to Python
if command -v node >/dev/null 2>&1; then
  NODE=node
elif command -v nodejs >/dev/null 2>&1; then
  NODE=nodejs
else
  NODE=""
fi

if [ -n "$NODE" ]; then
  TMPBASE=$(mktemp /tmp/gorilla.XXXXXX 2>/dev/null || mktemp -t gorilla 2>/dev/null || echo /tmp/gorilla-$$)
  TMPJS="${TMPBASE}.mjs"
  rm -f "$TMPBASE" 2>/dev/null || true
  cat > "$TMPJS" <<'NODEEOF'
#!/usr/bin/env node
// GORILLAS.BAS — Node.js terminal edition with P2P + pixel ASCII (web-like)
import * as readline from 'node:readline';
import { stdin as input, stdout as output } from 'node:process';
import fs from 'node:fs';

// --- tty handling for curl | sh ---
let inputStream=input, outputStream=output;
if (!process.stdin.isTTY) {
  let hasData=false;
  try { const st=fs.fstatSync(0); hasData=st.size>0; } catch {}
  // also check readableLength if available
  try { if (process.stdin.readableLength>0) hasData=true; } catch {}
  if (!hasData) {
    try {
      const fdIn=fs.openSync('/dev/tty','r');
      const fdOut=fs.openSync('/dev/tty','w');
      fs.closeSync(fdIn); fs.closeSync(fdOut);
      inputStream=fs.createReadStream('/dev/tty');
      outputStream=fs.createWriteStream('/dev/tty');
      inputStream.on('error',()=>{}); outputStream.on('error',()=>{});
    } catch {}
  }
}

// --- constants (match web) ---
const H=24, WORLD_W=80, GROUND=20, GOR_W=3, GOR_H=2, EXPL_R=4;
const VX=0.55, VY=0.32, GSCALE=0.95, WSCALE=0.22;
let gravity=9.8, crosshair=false, dropGorilla=false;
let mode='hot', myIndex=0, myNick='', oppNick='';
let lobby=null;

// --- RNG ---
function mulberry32(seed){ return function(){ seed|=0; seed=seed+0x6D2B79F5|0; let t=Math.imul(seed^seed>>>15,1|seed); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296}}
const fnRan=(rng,x)=>Math.floor(rng()*x)+1;
function newWind(rng){ let w=fnRan(rng,10)-5; if(fnRan(rng,3)===1) w+= w>0?fnRan(rng,10):-fnRan(rng,10); return Math.max(-14,Math.min(15,w)); }

// --- terrain ---
function genTerrain(rng){
  const buildings=[]; let x=1;
  while(x<WORLD_W-8){
    let bw=5+Math.floor(rng()*6); if(x+bw>WORLD_W-1) bw=WORLD_W-1-x;
    let bh=4+Math.floor(rng()*8);
    buildings.push({x,w:bw,top:GROUND-bh});
    x+=bw+(rng()<0.2?1:0);
  }
  const mid=WORLD_W>>1;
  const closest=t=>{ let best=null,bd=1e9; for(const b of buildings){ const cx=b.x+b.w/2|0, d=Math.abs(cx-t); if(d<bd){bd=d;best=b}} return best; };
  let b0=closest(mid-12), b1=closest(mid+12);
  if(b0===b1){ const idx=buildings.indexOf(b0); b1=buildings[idx+1]||buildings[idx-1]; }
  const mk=b=>({x:Math.round(b.x+b.w/2),y:b.top-GOR_H,alive:true});
  const top=new Int16Array(WORLD_W).fill(GROUND);
  for(const b of buildings) for(let c=Math.max(0,b.x);c<Math.min(WORLD_W,b.x+b.w);c++) top[c]=b.top;
  return {buildings,top,gorillas:[mk(b0),mk(b1)]};
}
const facingOf=i=> i===0?1:-1;
const launchPos=(g,f)=>[g.x + f*(GOR_W/2+1|0), g.y];

// --- physics ---
function makeShot(x,y,ang,vel,facing,wind,grav){
  const a=ang*Math.PI/180;
  return {x,y,vx:Math.cos(a)*vel*VX*facing, vy:-Math.sin(a)*vel*VY, g:grav*GSCALE, windA:wind*WSCALE};
}
function stepShot(s,dt){ s.vy+=s.g*dt; s.vx+=s.windA*dt; s.x+=s.vx*dt; s.y+=s.vy*dt; }
function collide(x,y,top,gorillas){
  if(x<-5||x>WORLD_W+5) return {type:'out'};
  for(let i=0;i<gorillas.length;i++){ const g=gorillas[i]; if(g.alive && Math.abs(x-g.x)<=GOR_W/2+1 && y>=g.y && y<=g.y+GOR_H) return {type:'gorilla',i}; }
  const c=Math.floor(x); if(c>=0&&c<WORLD_W&&y>=top[c]) return {type:'building'};
  if(y>=GROUND) return {type:'building'};
  return null;
}
function explode(x,y,top){
  const rr=EXPL_R*EXPL_R;
  for(let c=Math.max(0,Math.floor(x-EXPL_R));c<=Math.min(WORLD_W-1,Math.ceil(x+EXPL_R));c++){
    const dx=c-x, d2=rr-dx*dx; if(d2<0) continue;
    const bottom=y+Math.sqrt(d2);
    if(bottom>top[c]) top[c]=Math.min(GROUND, Math.max(top[c], Math.round(bottom)));
  }
}
function applyDrop(gorillas,top){ if(!dropGorilla) return; for(const g of gorillas){ if(!g.alive) continue; const cx=Math.max(0,Math.min(WORLD_W-1,Math.round(g.x))); const ny=top[cx]-GOR_H; if(ny>g.y) g.y=ny; } }
function solveShot(me,opp,top,gorillas,wind,grav){
  const f=facingOf(me), g=gorillas[me], lp=launchPos(g,f), tg=gorillas[opp], tx=tg.x, ty=tg.y+0.5;
  let best=null;
  for(let ang=12;ang<83;ang+=2) for(let vel=15;vel<120;vel+=4){
    const s=makeShot(lp[0],lp[1],ang,vel,f,wind,grav); let dmin=Infinity;
    for(let t=0;t<600;t++){ stepShot(s,0.08); const dx=s.x-tx,dy=s.y-ty,d=dx*dx+dy*dy; if(d<dmin) dmin=d; const c=collide(s.x,s.y,top,gorillas); if(c){ if(c.type==='gorilla'&&c.i===opp) dmin=0; break; } if(s.y>GROUND&&s.vy>0) break; }
    if(!best||dmin<best.d) best={ang,vel,d:dmin};
  }
  best.ang+=Math.random()*3-1.5; best.vel+=Math.random()*4-2;
  return [Math.max(0,Math.min(180,best.ang)), Math.max(1,Math.min(120,best.vel))];
}

// --- readline ---
const rl=readline.createInterface({input:inputStream, output:outputStream});
const ask=q=>new Promise(res=> rl.question(q,ans=>res(ans)));
const clear=()=> outputStream.write('\x1b[2J\x1b[H');

// --- draw (pixel blocks, web-like) ---
const BUILD_COLORS=['\x1b[48;5;30m','\x1b[48;5;124m','\x1b[48;5;244m','\x1b[48;5;127m','\x1b[48;5;28m','\x1b[48;5;130m'];
const SKY_BG='\x1b[48;5;19m', GOR_BG='\x1b[48;5;130m';
function draw(buildings,top,gorillas,wind,turn,scores,phase,msg,ang,vel,shot=null,boom=null){
  const buf=Array.from({length:H},()=>Array(WORLD_W).fill(null).map(()=>({ch:' ',fg:'',bg:''})));
  for(let idx=0;idx<buildings.length;idx++){
    const b=buildings[idx];
    const col=BUILD_COLORS[idx%BUILD_COLORS.length];
    for(let x=b.x;x<b.x+b.w;x++) for(let y=b.top;y<GROUND;y++) if(x>=0&&x<WORLD_W&&y>=0&&y<H){
      const isWin = (x-b.x)%3===1 && (y-b.top)%2===0 && y<GROUND-1 && Math.random()<0.42;
      buf[y][x]={ch: isWin?'·':'█', fg: isWin?'\x1b[38;5;226m':'\x1b[38;5;231m', bg:col};
    }
  }
  for(let x=0;x<WORLD_W;x++) if(GROUND<H) buf[GROUND][x]={ch:'▔',fg:'\x1b[38;5;27m',bg:SKY_BG};
  const sx=WORLD_W>>1, sy=3;
  if(sy>=0&&sy<H&&sx>=0&&sx<WORLD_W) buf[sy][sx]={ch:'☀',fg:'\x1b[38;5;226m',bg:SKY_BG};
  for(let i=0;i<gorillas.length;i++){
    const g=gorillas[i]; if(!g.alive) continue;
    const x=Math.round(g.x), y=Math.round(g.y);
    const cols=[['▓','▓','▓'],['▓','☺','▓']];
    for(let dy=0;dy<2;dy++) for(let dx=0;dx<3;dx++){
      const xx=x+dx-1, yy=y+dy;
      if(xx>=0&&xx<WORLD_W&&yy>=0&&yy<H) buf[yy][xx]={ch:cols[dy][dx], fg:'\x1b[38;5;94m', bg:GOR_BG};
    }
    if(g.alive){
      const eyeY=y+1;
      if(x>=0&&x<WORLD_W&&eyeY>=0&&eyeY<H) buf[eyeY][x-1]={ch:'·',fg:'\x1b[38;5;231m',bg:GOR_BG};
      if(x+1>=0&&x+1<WORLD_W&&eyeY>=0&&eyeY<H) buf[eyeY][x+1]={ch:'·',fg:'\x1b[38;5;231m',bg:GOR_BG};
    }
    if(phase==='aim'&&turn===i){
      const bx=x+facingOf(i)*2, by=y-1;
      if(bx>=0&&bx<WORLD_W&&by>=0&&by<H) buf[by][bx]={ch:'o',fg:'\x1b[38;5;226m',bg:SKY_BG};
    }
  }
  if(crosshair && phase==='aim' && gorillas[turn]?.alive){
    const f=facingOf(turn), lp=launchPos(gorillas[turn],f), rad=ang*Math.PI/180, len=7;
    const x2=Math.round(lp[0]+Math.cos(rad)*len*f), y2=Math.round(lp[1]-Math.sin(rad)*len);
    const steps=Math.max(Math.abs(x2-lp[0]),Math.abs(y2-lp[1]),1);
    for(let t=0;t<=steps;t++){
      const x=Math.round(lp[0]+(x2-lp[0])*t/steps), y=Math.round(lp[1]+(y2-lp[1])*t/steps);
      if(x>=0&&x<WORLD_W&&y>=0&&y<H&&buf[y][x].ch===' ') buf[y][x]={ch:'·',fg:'\x1b[38;5;226m',bg:SKY_BG};
    }
    if(x2>=0&&x2<WORLD_W&&y2>=0&&y2<H) buf[y2][x2]={ch:'+',fg:'\x1b[38;5;226m',bg:SKY_BG};
  }
  if(shot && phase==='flying'){
    const x=Math.round(shot.x), y=Math.round(shot.y);
    if(x>=0&&x<WORLD_W&&y>=0&&y<H) buf[y][x]={ch:'●',fg:'\x1b[38;5;226m',bg:SKY_BG};
  }
  if(boom){
    const x=Math.round(boom.x), y=Math.round(boom.y);
    for(let dy=-1;dy<=1;dy++) for(let dx=-1;dx<=1;dx++){
      const xx=x+dx, yy=y+dy;
      if(xx>=0&&xx<WORLD_W&&yy>=0&&yy<H) buf[yy][xx]={ch:'*',fg:'\x1b[38;5;202m',bg:'\x1b[48;5;208m'};
    }
  }
  clear();
  const hud = `\x1b[44m\x1b[97m ${turn===0?'▶':''}\x1b[38;5;46m YOU ${scores[0]} \x1b[97m ${wind===0?'CALM':(wind>0?'→':'←')+' '+Math.abs(wind)}  \x1b[38;5;51m ${scores[1]} ${turn===1?'◀':''} ${mode==='bot'?'COMPUTER':'P2'} \x1b[0m`;
  outputStream.write(hud+'\n');
  if(msg) outputStream.write(`\x1b[38;5;226m${msg.padStart(40+msg.length/2).padEnd(80)}\x1b[0m\n`);
  for(let y=0;y<H;y++){
    let line=''; let lastBg='', lastFg='';
    for(let x=0;x<WORLD_W;x++){
      const cell=buf[y][x];
      const bg=cell.bg||SKY_BG, fg=cell.fg||'\x1b[38;5;231m';
      if(bg!==lastBg || fg!==lastFg){ line+=bg+fg; lastBg=bg; lastFg=fg; }
      line+=cell.ch;
    }
    line+='\x1b[0m';
    outputStream.write(line+'\n');
  }
  outputStream.write(`\n\x1b[38;5;250mANGLE \x1b[38;5;226m${ang.toFixed(0).padStart(3)}°\x1b[38;5;250m  VELO \x1b[38;5;226m${vel.toFixed(0).padStart(3)}\x1b[38;5;250m  grav ${gravity.toFixed(1)}  [cross ${crosshair?'ON':'OFF'} drop ${dropGorilla?'ON':'OFF'}]\x1b[0m\n`);
}

// --- P2P (Trystero + werift) ---
let net={room:null,opponent:null,started:false,code:null,isHost:false};
async function loadTrystero(){
  try{ return await import('trystero'); }catch{
    try{
      // try require for commonjs
      const {createRequire}=await import('node:module');
      const require=createRequire(import.meta.url);
      return require('trystero');
    }catch{ return null; }
  }
}
async function loadRTC(){
  try{ const {RTCPeerConnection}=await import('werift'); return RTCPeerConnection; }catch{ return null; }
}
function genCode(){
  const animals='koala,panda,tiger,lion,zebra,giraffe,monkey,dolphin,eagle,falcon,fox,wolf,bear,otter,penguin,raccoon,sloth,lemur,gecko,iguana,jaguar,leopard,llama,meerkat,narwhal,ocelot,puffin,quokka,shark,toucan,walrus,yak,alpaca,bison,camel,dingo,emu,ferret,gorilla,hamster,ibex'.split(',');
  return animals[Math.floor(Math.random()*animals.length)]+'-'+(10+Math.floor(Math.random()*90));
}

// --- game loop ---
async function gameLoop(rng, myMode){
  let {buildings,top,gorillas}=genTerrain(rng);
  let wind=newWind(rng), turn=0, scores=[0,0], phase='aim', ang=45, vel=50, shot=null, boom=null;
  while(true){
    const msg = myMode==='hot'?`PLAYER ${turn+1}'S TURN` : (myMode==='bot'? (turn===0?`YOUR TURN`:`COMPUTER'S TURN`) : (turn===myIndex?`YOUR TURN`:`OPPONENT'S TURN`));
    draw(buildings,top,gorillas,wind,turn,scores,phase,msg,ang,vel,shot,boom);
    if(myMode==='bot' && turn===1 && phase==='aim'){
      outputStream.write("COMPUTER IS THINKING…\n"); await new Promise(r=>setTimeout(r,700));
      const [a,v]=solveShot(1,0,top,gorillas,wind,gravity);
      ang=a; vel=v;
      outputStream.write(`COMPUTER FIRES: angle ${a.toFixed(0)} velocity ${v.toFixed(0)}\n`); await new Promise(r=>setTimeout(r,600));
      const f=facingOf(turn), lp=launchPos(gorillas[turn],f);
      shot=makeShot(lp[0],lp[1],ang,vel,f,wind,gravity); phase='flying';
      for(let i=0;i<800;i++){
        stepShot(shot,0.08);
        const c=collide(shot.x,shot.y,top,gorillas);
        draw(buildings,top,gorillas,wind,turn,scores,'flying',"BANANA IN FLIGHT…",ang,vel,shot);
        await new Promise(r=>setTimeout(r,22));
        if(c||shot.y>=GROUND||shot.x<-5||shot.x>WORLD_W+5) break;
      }
      const c=collide(shot.x,shot.y,top,gorillas);
      shot=null; phase='boom'; boom={x:shot?.x||0,y:shot?.y||0};
      if(c && c.type==='gorilla'){
        gorillas[c.i].alive=false;
        draw(buildings,top,gorillas,wind,turn,scores,'boom',"HIT!",ang,vel,null,boom); await new Promise(r=>setTimeout(r,500));
        if(c.i!==turn) scores[turn]++; else scores[turn^1]++;
        await new Promise(r=>setTimeout(r,800));
        ({buildings,top,gorillas}=genTerrain(rng)); wind=newWind(rng); turn=0; phase='aim'; continue;
      } else if(c && c.type==='building'){
        draw(buildings,top,gorillas,wind,turn,scores,'boom',"BOOM!",ang,vel,null,boom); await new Promise(r=>setTimeout(r,400));
        explode(boom.x,boom.y,top); applyDrop(gorillas,top); wind=newWind(rng); turn^=1; phase='aim'; continue;
      } else {
        wind=newWind(rng); turn^=1; phase='aim'; continue;
      }
    } else if(myMode==='net' && turn!==myIndex && phase==='aim'){
      draw(buildings,top,gorillas,wind,turn,scores,phase,"OPPONENT'S TURN — WAITING…",ang,vel);
      await new Promise(r=>setTimeout(r,300));
      continue;
    } else {
      const aStr=await ask(`Angle (0-180) [${ang.toFixed(0)}]: `);
      if(aStr.trim()!==''){ const v=parseFloat(aStr); if(!isNaN(v)) ang=Math.max(0,Math.min(180,v)); }
      const vStr=await ask(`Velocity (1-200) [${vel.toFixed(0)}]: `);
      if(vStr.trim()!==''){ const v=parseFloat(vStr); if(!isNaN(v)) vel=Math.max(1,Math.min(200,v)); }
      const f=facingOf(turn), lp=launchPos(gorillas[turn],f);
      shot=makeShot(lp[0],lp[1],ang,vel,f,wind,gravity);
      if(myMode==='net' && net.room){
        try{ net.sendShot({a:ang,v:vel}); }catch{}
      }
      phase='flying';
      for(let i=0;i<800;i++){
        stepShot(shot,0.08);
        const c=collide(shot.x,shot.y,top,gorillas);
        draw(buildings,top,gorillas,wind,turn,scores,'flying',"BANANA IN FLIGHT…",ang,vel,shot);
        await new Promise(r=>setTimeout(r,22));
        if(c||shot.y>=GROUND||shot.x<-5||shot.x>WORLD_W+5) break;
      }
      const c=collide(shot.x,shot.y,top,gorillas);
      shot=null;
      if(!c && shot && shot.y>=GROUND-1){
        outputStream.write("Miss!\n"); await new Promise(r=>setTimeout(r,1200)); wind=newWind(rng); turn^=1; phase='aim'; continue;
      }
      if(c && c.type==='out'){ outputStream.write("Off screen!\n"); await new Promise(r=>setTimeout(r,1200)); wind=newWind(rng); turn^=1; phase='aim'; continue; }
      if(c && c.type==='building'){
        boom={x:shot.x,y:shot.y}; draw(buildings,top,gorillas,wind,turn,scores,'boom',"BOOM!",ang,vel,null,boom); await new Promise(r=>setTimeout(r,400));
        explode(boom.x,boom.y,top); applyDrop(gorillas,top); wind=newWind(rng); turn^=1; phase='aim'; boom=null; continue;
      }
      if(c && c.type==='gorilla'){
        gorillas[c.i].alive=false;
        boom={x:shot.x,y:shot.y}; draw(buildings,top,gorillas,wind,turn,scores,'boom',"HIT!",ang,vel,null,boom); await new Promise(r=>setTimeout(r,500));
        if(c.i!==turn) scores[turn]++; else scores[turn^1]++;
        await new Promise(r=>setTimeout(r,800));
        ({buildings,top,gorillas}=genTerrain(rng)); wind=newWind(rng); turn=0; phase='aim'; boom=null; continue;
      }
      wind=newWind(rng); turn^=1; phase='aim';
    }
  }
}

// --- lobby + online ---
async function onlineFlow(rng){
  let nick=await ask("Nickname (2-12) [Gorilla]: ");
  nick=nick.trim()||'Gorilla'+Math.floor(Math.random()*90+10);
  nick=nick.slice(0,12); myNick=nick;
  outputStream.write(`\nHello ${nick}!\n`);
  let trystero=null, RTCPeerConnection=null;
  try{ trystero=await loadTrystero(); }catch{}
  try{ RTCPeerConnection=await loadRTC(); }catch{}
  if(!trystero || !RTCPeerConnection){
    outputStream.write("P2P not available (npm i trystero werift for online).\n");
    outputStream.write("Try: mkdir /tmp/gorilla && cd /tmp/gorilla && npm init -y && npm i trystero werift && NODE_PATH=/tmp/gorilla/node_modules node $TMPJS\n");
    await new Promise(r=>setTimeout(r,1500));
    return;
  }
  const lobbyRoom=trystero.joinRoom({appId:'gorillas-bas-browser-v2', rtcPolyfill:RTCPeerConnection}, '_lobby-v1');
  const lobbyAnn=lobbyRoom.makeAction('lobbyAnnounce');
  const joinReq=lobbyRoom.makeAction('joinReq');
  const rooms=new Map();
  lobbyAnn.onMessage((data,meta)=>{
    if(!data||!data.code) return;
    rooms.set(data.code,{...data, peerId:meta.peerId, ts:Date.now()});
  });
  joinReq.onMessage((data,meta)=>{
    if(data.code===net.code) outputStream.write(`\n>> ${data.nick} wants to join ${data.code}!\n`);
  });
  while(true){
    // clear not needed, draw lobby
    outputStream.write(`\x1b[44m\x1b[93m ● LIVE ROOMS \x1b[0m  (nick: ${nick})\n`);
    for(const [k,v] of rooms) if(Date.now()-v.ts>14000) rooms.delete(k);
    const list=[...rooms.values()].filter(r=>r.code!==net.code).sort((a,b)=>b.ts-a.ts);
    if(list.length===0) outputStream.write("No rooms yet — you can HOST.\n");
    else list.forEach((r,i)=> outputStream.write(`${i+1}) ${r.nick} @ ${r.code} ${r.hasOpponent?'FULL':'OPEN'} grav ${r.gravity}\n`));
    outputStream.write("\n[H] HOST  [J] JOIN code  [number] REQUEST JOIN  [R] REFRESH  [B] BACK\n");
    const ch=(await ask("> ")).trim().toLowerCase();
    if(ch==='h'){
      const code=genCode();
      net.code=code; net.isHost=true; myIndex=0;
      const room=trystero.joinRoom({appId:'gorillas-bas-browser-v2', rtcPolyfill:RTCPeerConnection}, code);
      net.room=room; net.opponent=null; net.started=false;
      const initAct=room.makeAction('init'), shotAct=room.makeAction('shot'), ackAct=room.makeAction('ack');
      net.sendShot=d=>shotAct.send(d); net.sendInit=d=>initAct.send(d);
      const ann=setInterval(()=>{ try{lobbyAnn.send({code,nick,gravity,hasOpponent:!!net.opponent,started:!!net.started,ts:Date.now()});}catch{} },2500);
      lobbyAnn.send({code,nick,gravity,hasOpponent:false,started:false,ts:Date.now()});
      room.onPeerJoin=id=>{ if(net.opponent) return; net.opponent=id; outputStream.write(`\n>>> ${id} CONNECTED! Press S to START\n`); };
      ackAct.onMessage=()=>{ clearInterval(ann); };
      outputStream.write(`\nHosting ${code} — share code or wait for lobby join. [S] START when opponent connects, [B] back\n`);
      while(!net.started){
        const k=(await ask("")).trim().toLowerCase();
        if(k==='s' && net.opponent){ 
          const seed=Math.floor(Math.random()*2**31);
          try{ initAct.send({seed,gravity,nick,drop:dropGorilla}); }catch{}
          net.started=true; clearInterval(ann);
          await gameLoop(rng,'net');
          break;
        }
        if(k==='b'){ try{room.leave();}catch{}; clearInterval(ann); break; }
      }
    } else if(ch==='j'){
      const code=(await ask("Enter code (koala-42): ")).trim().toLowerCase();
      if(!/^[a-z]+-\d{1,3}$/.test(code)){ outputStream.write("Bad code\n"); continue; }
      try{ joinReq.send({code,nick,ts:Date.now()}); }catch{}
      const room=trystero.joinRoom({appId:'gorillas-bas-browser-v2', rtcPolyfill:RTCPeerConnection}, code);
      net.room=room; net.code=code; net.isHost=false; myIndex=1; net.opponent=null;
      const initAct=room.makeAction('init'), shotAct=room.makeAction('shot'), ackAct=room.makeAction('ack');
      net.sendShot=d=>shotAct.send(d);
      let started=false;
      initAct.onMessage=data=>{
        if(data.gravity) gravity=data.gravity;
        if(typeof data.drop==='boolean') dropGorilla=data.drop;
        started=true;
        try{ ackAct.send({nick,drop:dropGorilla}); }catch{}
      };
      room.onPeerJoin=id=>{ net.opponent=id; outputStream.write(`\n>>> Connected to ${id} — waiting for host to START\n`); };
      outputStream.write(`Joined ${code}, waiting for host...\n`);
      while(!started) await new Promise(r=>setTimeout(r,500));
      await gameLoop(rng,'net');
    } else if(/^\d+$/.test(ch)){
      const idx=parseInt(ch,10)-1;
      const list=[...rooms.values()].filter(r=>r.code!==net.code).sort((a,b)=>b.ts-a.ts);
      if(list[idx]){
        const r=list[idx];
        try{ joinReq.send({code:r.code,nick,ts:Date.now()},{target:r.peerId}); }catch{}
        outputStream.write(`Request sent to ${r.nick} @ ${r.code}, joining...\n`);
        await new Promise(r=>setTimeout(r,800));
      }
    } else if(ch==='r'){ continue; }
    else if(ch==='b') break;
  }
}

async function main(){
  const rng=mulberry32(Date.now()&0xffffffff);
  while(true){
    outputStream.write('\x1b[2J\x1b[H');
    outputStream.write('\x1b[44m\x1b[93m\n  ##### GORILLAS.BAS #####  \n\x1b[0m\n');
    outputStream.write('  ★ NODE TERMINAL + P2P ★  (pixels via half-blocks, like web)\n');
    outputStream.write(`  gravity ${gravity.toFixed(1)}  crosshair ${crosshair?'ON':'OFF'}  drop ${dropGorilla?'ON':'OFF'}\n\n`);
    outputStream.write('  1) TWO PLAYERS (hotseat, ASCII pixels)\n');
    outputStream.write('  2) PLAY VS COMPUTER\n');
    outputStream.write('  3) ONLINE P2P (Node.js + Trystero/werift)\n');
    outputStream.write('  4) SETTINGS\n');
    outputStream.write('  5) QUIT\n');
    const ch=(await ask('\nSelect 1-5 > ')).trim();
    if(ch==='1') await gameLoop(rng,'hot');
    else if(ch==='2') await gameLoop(rng,'bot');
    else if(ch==='3') await onlineFlow(rng);
    else if(ch==='4'){
      const g=await ask(`Gravity 1-30 [${gravity}]: `); if(g.trim()) gravity=Math.max(1,Math.min(30,parseFloat(g)||gravity));
      const c=await ask(`Crosshair ON/OFF [${crosshair?'ON':'OFF'}]: `); if(c.toLowerCase().startsWith('y')||c.toLowerCase()==='on') crosshair=true; else if(c.toLowerCase().startsWith('n')||c==='off') crosshair=false;
      const d=await ask(`Drop Gorilla ON/OFF [${dropGorilla?'ON':'OFF'}]: `); if(d.toLowerCase().startsWith('y')||d==='on') dropGorilla=true; else if(d.toLowerCase().startsWith('n')||d==='off') dropGorilla=false;
    }
    else if(ch==='5') { outputStream.write('Bye!\n'); process.exit(0); }
  }
}

